# Only mobile source and build tools may leave this computer.
*
!/.easignore
!/app.json
!/eas.json
!/package.json
!/package-lock.json
!/tsconfig.json
!/App.tsx
!/index.ts
!/assets
!/assets/*.png
!/src
!/src/*.ts
!/src/*.tsx
!/src/mexc
!/src/mexc/*.ts
!/src/mexc/*.tsx
!/modules
!/modules/ths-chart-pip
!/modules/ths-chart-pip/expo-module.config.json
!/modules/ths-chart-pip/ios
!/modules/ths-chart-pip/ios/*
!/.eas
!/.eas/build
!/.eas/build/unsigned-ios.yml
!/scripts
!/scripts/build-unsigned-ios.sh
!/scripts/verify-ipa.py

**/.env*
**/*personal-config*
**/SchwabPersonalConfiguration.plist
**/credentials.json
**/*.p12
**/*.p8
**/*.pem
**/*.key
**/*.mobileprovision
**/node_modules
**/.expo
**/.git
