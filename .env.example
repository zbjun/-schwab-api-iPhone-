# Local desktop integration configuration only.
# Used by tools/schwab-connect/server.mjs. Alternatively enter keys in its local UI.
# Never include the filled configuration in an iOS build or send it in chat.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=

# Manual personal-use flow: register this exact URL in the Schwab portal.
# No callback web server is started. Paste the final browser URL into the local UI.
SCHWAB_REDIRECT_URI=https://127.0.0.1
