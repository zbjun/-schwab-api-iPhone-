# Deny everything by default. Re-open directories only to reach allowed files.
# EAS checks directory entries without a trailing slash during its copy walk.
*
!/.easignore
!/package.json
!/package-lock.json
!/app.json
!/eas.json

!/.eas
!/.eas/build
!/.eas/build/native-ios.yml

!/ios
!/ios/THS
!/ios/THS/App
!/ios/THS/Models
!/ios/THS/Services
!/ios/THS/Views
!/ios/THS/**/*.swift
!/ios/THS/Info.plist
!/ios/THSTests
!/ios/THSTests/**/*.swift
!/ios/THSUITests
!/ios/THSUITests/**/*.swift
!/ios/THS.xcodeproj
!/ios/THS.xcodeproj/project.pbxproj
!/ios/THS.xcodeproj/xcshareddata
!/ios/THS.xcodeproj/xcshareddata/xcschemes
!/ios/THS.xcodeproj/xcshareddata/xcschemes/THS.xcscheme

!/tools
!/tools/ios
!/tools/ios/build-native.sh
!/tools/ios/generate-project.mjs
!/tools/ios/select-simulator.py
!/tools/ios/verify-ipa.py

# These stay denied even if a directory allowlist is expanded later.
**/.env
**/.env.*
**/.secrets/
**/tokens/
**/credentials.json
**/SchwabPersonalConfiguration.plist
**/*.p8
**/*.p12
**/*.pfx
**/*.pem
**/*.key
**/*.cer
**/*.mobileprovision
**/*.ipa
**/*.xcarchive/
**/*.xcresult/
**/xcuserdata/
**/node_modules/
/artifacts/
/reports/
/tools/schwab-connect/
/.git/
/.github/
/.omx/
